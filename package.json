  ],
  "author": "Snapstock team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorndotdev/snapstock-mcp.git"
  },
  "homepage": "https://learn.snapstock.app/data/dividend-safety/",
  "bugs": {
    "url": "https://github.com/sorndotdev/snapstock-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "csv-parse": "^7.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
