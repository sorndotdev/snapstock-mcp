{
  "name": "snapstock-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for Snapstock's free dividend safety scores, red flags, and dividend history.",
  "type": "module",
  "bin": {
    "snapstock-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE",
    "DATA-LICENSE.md"
  ],
  "scripts": {
